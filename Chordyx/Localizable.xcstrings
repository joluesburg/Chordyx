        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional — MIDI aprende tu estilo por defecto. El micrófono solo se usa al escuchar el tempo; se apaga cuando empieza la batería para evitar feedback."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
