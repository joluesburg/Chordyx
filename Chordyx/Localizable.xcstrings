    "“%@” is already saved. Replace it with this import, or save under a new name.": {
      "comment": "A confirmation dialog message that appears when the user scans a song and it matches an existing song in their library.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ya está guardado. Reemplázalo con esta importación o guárdalo con un nombre nuevo."
